    // --- A. Live 4-Year Countdown Timer ---
    function updateCountdown() {
      const start = new Date(CONFIG.departureDate).getTime();
      const end = new Date(CONFIG.returnDate).getTime();
      const now = new Date().getTime();

      const diff = Math.max(0, end - now);
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / 1000 / 60) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      document.getElementById('cd-days').textContent = String(days).padStart(2, '0');
      document.getElementById('cd-hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('cd-minutes').textContent = String(minutes).padStart(2, '0');
      document.getElementById('cd-seconds').textContent = String(seconds).padStart(2, '0');

      // Calculate Progress Percentage
      const totalDuration = end - start;
      const elapsed = Math.max(0, now - start);
      const percentage = Math.min(100, Math.max(5, ((elapsed / totalDuration) * 100))).toFixed(2);
      document.getElementById('journey-bar').style.width = `${percentage}%`;
      document.getElementById('journey-percent').textContent = `${percentage}% of Our Distance Completed`;
    }

