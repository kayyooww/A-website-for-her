        let noteIdx = 0;
        synthInterval = setInterval(() => {
          const notes = playlist[currentTrack].notes;
          playMusicBoxNote(notes[noteIdx % notes.length]);
          noteIdx++;
        }, 650);
      } else {
        vinyl.classList.remove('animate-spin-slow');
        playBtn.innerHTML = `<i data-lucide="play" class="w-4 h-4 fill-current ml-0.5"></i>`;
        clearInterval(synthInterval);
