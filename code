<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>For My Cupcakes — Our 4-Year Promise</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Cormorant Garamond (Romantic Serif), Plus Jakarta Sans (Clean Body), Great Vibes (Script) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Tailwind Configuration -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            pastel: {
              peach: '#ffb5a7',
              pink: '#ffcad4',
              lavender: '#d8bbff',
              periwinkle: '#b5b9ff',
              cream: '#fdf0ed',
              dark: '#4a3548',
              muted: '#7d657b'
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            script: ['"Great Vibes"', 'cursive']
          },
          animation: {
            'float-slow': 'float 6s ease-in-out infinite',
            'pulse-glow': 'pulseGlow 3s ease-in-out infinite',
            'spin-slow': 'spin 8s linear infinite',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-12px)' },
            },
            pulseGlow: {
              '0%, 100%': { boxShadow: '0 0 15px rgba(255, 181, 167, 0.4), 0 0 30px rgba(216, 187, 255, 0.3)' },
              '50%': { boxShadow: '0 0 25px rgba(255, 181, 167, 0.8), 0 0 45px rgba(216, 187, 255, 0.6)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Base Custom Styling & Background Mesh */
    body {
      background-color: #fdf0ed;
      background-image: 
        radial-gradient(at 10% 10%, rgba(255, 202, 212, 0.55) 0px, transparent 50%),
        radial-gradient(at 90% 15%, rgba(216, 187, 255, 0.5) 0px, transparent 50%),
        radial-gradient(at 50% 50%, rgba(253, 240, 237, 0.8) 0px, transparent 60%),
        radial-gradient(at 15% 85%, rgba(181, 185, 255, 0.45) 0px, transparent 50%),
        radial-gradient(at 85% 90%, rgba(255, 181, 167, 0.5) 0px, transparent 50%);
      background-attachment: fixed;
      color: #4a3548;
      overflow-x: hidden;
    }

    /* Glassmorphism Utilities */
    .glass-card {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.85);
      box-shadow: 0 10px 35px -5px rgba(181, 140, 175, 0.15), 0 0 15px rgba(255, 202, 212, 0.25);
    }

    .glass-card-hover {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .glass-card-hover:hover {
      transform: translateY(-6px);
      background: rgba(255, 255, 255, 0.82);
      border-color: #ffcad4;
      box-shadow: 0 18px 40px -5px rgba(181, 140, 175, 0.25), 0 0 25px rgba(216, 187, 255, 0.5);
    }

    /* Polaroid Frame Styling */
    .polaroid {
      background: #ffffff;
      padding: 12px 12px 32px 12px;
      box-shadow: 0 12px 28px rgba(74, 53, 72, 0.12);
      border-radius: 6px;
      transition: transform 0.35s ease, box-shadow 0.35s ease;
    }
    .polaroid:hover {
      transform: scale(1.03) rotate(0deg) !important;
      box-shadow: 0 20px 35px rgba(74, 53, 72, 0.2);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #fdf0ed;
    }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(to bottom, #ffb5a7, #d8bbff);
      border-radius: 9999px;
    }

    /* Shake Animation for Wrong Passcode */
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-8px); }
      40%, 80% { transform: translateX(8px); }
    }
    .animate-shake {
      animation: shake 0.45s ease-in-out;
    }

    /* Envelope Seal Glow */
    .wax-seal {
      background: linear-gradient(135deg, #ffb5a7 0%, #d8bbff 100%);
      box-shadow: 0 4px 12px rgba(255, 181, 167, 0.5);
    }
  </style>
</head>
<body class="font-sans antialiased selection:bg-pastel-pink selection:text-pastel-dark relative">

  <!-- ==========================================
       BACKGROUND FLOATING PARTICLES CANVAS
  =========================================== -->
  <canvas id="particle-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

  <!-- ==========================================
       FLOATING NAVIGATION BAR
  =========================================== -->
  <header class="fixed top-4 left-0 right-0 z-40 px-4">
    <nav class="max-w-4xl mx-auto glass-card rounded-full px-6 py-3 flex items-center justify-between">
      <a href="#hero" class="flex items-center gap-2 group">
        <span class="w-8 h-8 rounded-full bg-gradient-to-tr from-pastel-peach to-pastel-lavender flex items-center justify-center text-white shadow-sm group-hover:scale-110 transition-transform">
          <i data-lucide="heart" class="w-4 h-4 fill-current"></i>
        </span>
        <span class="font-serif font-bold text-lg tracking-wide text-pastel-dark">For My Cupcakes</span>
      </a>

      <div class="hidden md:flex items-center gap-6 text-sm font-medium text-pastel-muted">
        <a href="#hero" class="hover:text-pastel-dark transition-colors">Countdown</a>
        <a href="#timeline" class="hover:text-pastel-dark transition-colors">Our 1st Year</a>
        <a href="#vault" class="hover:text-pastel-dark transition-colors flex items-center gap-1">
          <i data-lucide="lock" class="w-3.5 h-3.5 text-pastel-peach"></i> Video Vault
        </a>
        <a href="#open-when" class="hover:text-pastel-dark transition-colors">Open When</a>
        <a href="#promise" class="hover:text-pastel-dark transition-colors">My Promise</a>
      </div>

      <!-- Easter Egg Progress Counter -->
      <button onclick="showEasterEggHint()" class="flex items-center gap-1.5 bg-white/80 hover:bg-white px-3 py-1.5 rounded-full text-xs font-semibold text-pastel-dark border border-pastel-pink/60 shadow-sm transition-all" title="Click for a hint!">
        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-pastel-peach"></i>
        <span>Secrets: <span id="egg-counter">0</span>/3</span>
      </button>
    </nav>
  </header>

  <!-- ==========================================
       FLOATING CUPCAKE EASTER EGG (#1)
  =========================================== -->
  <button 
    onclick="triggerEasterEgg(1)" 
    class="fixed bottom-6 left-6 z-40 group glass-card p-3.5 rounded-full hover:scale-110 transition-all duration-300 animate-float-slow shadow-lg border-pastel-pink"
    title="Psst... click the cupcake!"
  >
    <div class="relative">
      <i data-lucide="cake" class="w-6 h-6 text-pastel-peach group-hover:text-pink-500 transition-colors"></i>
      <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pastel-peach opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-pink-400"></span>
      </span>
    </div>
  </button>

  <!-- ==========================================
       FLOATING MUSIC PLAYER ("Bibbidi-Bobbidi" & "Lavay")
  =========================================== -->
  <div class="fixed bottom-6 right-6 z-40">
    <div class="glass-card rounded-2xl p-3.5 flex items-center gap-3.5 shadow-xl border border-white/90 max-w-xs sm:max-w-sm">
      <!-- Spinning Vinyl Record -->
      <div id="vinyl-disc" class="w-12 h-12 rounded-full bg-gradient-to-tr from-pastel-dark via-pastel-muted to-pastel-lavender p-1 flex items-center justify-center shadow-inner relative shrink-0">
        <div class="w-4 h-4 rounded-full bg-pastel-cream border-2 border-pastel-peach"></div>
      </div>

      <!-- Song Info -->
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-1.5">
          <span class="inline-block w-2 h-2 rounded-full bg-pastel-peach animate-pulse"></span>
          <p class="text-[10px] uppercase tracking-wider font-semibold text-pastel-muted">Cupcakes' Vibe Playlist</p>
        </div>
        <p id="track-title" class="text-sm font-bold text-pastel-dark truncate">Bibbidi-Bobbidi (Our Magic Vibe)</p>
        <p id="track-artist" class="text-xs text-pastel-muted truncate">Track 1 • Click play for cozy synth</p>
      </div>

      <!-- Controls -->
      <div class="flex items-center gap-1">
        <button onclick="toggleMusic()" id="play-btn" class="w-9 h-9 rounded-full bg-gradient-to-r from-pastel-peach to-pastel-lavender text-white flex items-center justify-center shadow-md hover:opacity-90 transition">
          <i data-lucide="play" id="play-icon" class="w-4 h-4 fill-current ml-0.5"></i>
        </button>
        <button onclick="nextTrack()" class="w-8 h-8 rounded-full hover:bg-white/60 text-pastel-dark flex items-center justify-center transition" title="Switch Track (Bibbidi-Bobbidi / Lavay)">
          <i data-lucide="skip-forward" class="w-4 h-4"></i>
        </button>
      </div>
    </div>
    <!-- Optional HTML5 Audio Element (Replace src with actual MP3 files if desired; includes gentle Web-Audio Chime synth fallback!) -->
    <audio id="bg-audio" loop></audio>
  </div>

  <!-- ==========================================
       SECTION A: HERO LANDING & LIVE COUNTDOWN
  =========================================== -->
  <section id="hero" class="relative min-h-screen flex items-center justify-center pt-28 pb-20 px-4 z-10">
    <div class="max-w-4xl mx-auto text-center">
      
      <!-- Personalized Nickname Badge -->
      <div class="inline-flex items-center gap-2 glass-card px-5 py-2 rounded-full mb-6 animate-float-slow">
        <i data-lucide="sparkles" class="w-4 h-4 text-pastel-peach"></i>
        <span class="text-xs sm:text-sm font-semibold tracking-wide text-pastel-dark">
          Dedicated to my sweetest <span class="text-pink-500 underline decoration-pastel-pink decoration-wavy underline-offset-4">Cupcakes</span> 🧁
        </span>
        <!-- Hidden Star Easter Egg (#2) -->
        <button onclick="triggerEasterEgg(2)" class="ml-1 text-pastel-lavender hover:text-yellow-400 transition-transform hover:scale-125" title="A tiny secret star...">
          <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
        </button>
      </div>

      <!-- Main Romantic Heading -->
      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-bold text-pastel-dark leading-tight mb-6">
        Counting the Days Until <br />
        <span class="bg-gradient-to-r from-pink-400 via-purple-400 to-indigo-400 bg-clip-text text-transparent italic font-normal">
          We're Together Again
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg text-pastel-muted leading-relaxed mb-10">
        Hey Cupcakes, four years of studying abroad might put miles between us on a map, 
        but not a single millimeter between our hearts. This website is my digital promise ring to you—a safe 
        place holding our first year of memories, 30+ secret videos, and my unwavering commitment to our future.
      </p>

      <!-- Live 4-Year Countdown Card -->
      <div class="glass-card rounded-3xl p-6 sm:p-10 mb-10 max-w-3xl mx-auto animate-pulse-glow">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-6 border-b border-pastel-pink/40 pb-4">
          <div class="flex items-center gap-2 text-left">
            <i data-lucide="calendar-heart" class="w-5 h-5 text-pastel-peach"></i>
            <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-pastel-muted">
              Countdown to Our Forever Reunion
            </span>
          </div>
          <span id="target-date-label" class="text-xs font-medium bg-pastel-pink/30 text-pastel-dark px-3 py-1 rounded-full">
            Departure: 4-Year Study Journey
          </span>
        </div>

        <!-- Countdown Digits Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
          <div class="bg-white/75 rounded-2xl p-4 shadow-sm border border-pastel-pink/40">
            <div id="cd-days" class="font-serif text-4xl sm:text-5xl font-bold text-pastel-dark">1461</div>
            <div class="text-xs uppercase tracking-widest text-pastel-muted mt-1 font-semibold">Days</div>
          </div>
          <div class="bg-white/75 rounded-2xl p-4 shadow-sm border border-pastel-lavender/40">
            <div id="cd-hours" class="font-serif text-4xl sm:text-5xl font-bold text-pastel-dark">00</div>
            <div class="text-xs uppercase tracking-widest text-pastel-muted mt-1 font-semibold">Hours</div>
          </div>
          <div class="bg-white/75 rounded-2xl p-4 shadow-sm border border-pastel-periwinkle/40">
            <div id="cd-minutes" class="font-serif text-4xl sm:text-5xl font-bold text-pastel-dark">00</div>
            <div class="text-xs uppercase tracking-widest text-pastel-muted mt-1 font-semibold">Minutes</div>
          </div>
          <div class="bg-white/75 rounded-2xl p-4 shadow-sm border border-pastel-peach/40">
            <div id="cd-seconds" class="font-serif text-4xl sm:text-5xl font-bold text-pink-500">00</div>
            <div class="text-xs uppercase tracking-widest text-pastel-muted mt-1 font-semibold">Seconds</div>
          </div>
        </div>

        <!-- Journey Progress Bar -->
        <div class="text-left">
          <div class="flex justify-between text-xs font-semibold text-pastel-muted mb-2">
            <span>Departure Day</span>
            <span id="journey-percent">Our 4-Year Bridge in Progress...</span>
            <span>Home in Your Arms</span>
          </div>
          <div class="w-full h-3 bg-white/80 rounded-full overflow-hidden p-0.5 border border-pastel-pink/50">
            <div id="journey-bar" class="h-full rounded-full bg-gradient-to-r from-pastel-peach via-pastel-pink to-pastel-lavender transition-all duration-1000" style="width: 8%"></div>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#timeline" class="px-7 py-3.5 rounded-full bg-gradient-to-r from-pastel-peach to-pastel-lavender text-pastel-dark font-semibold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center gap-2">
          <span>Walk Down Memory Lane</span>
          <i data-lucide="arrow-down-right" class="w-4 h-4"></i>
        </a>
        <a href="#vault" class="px-7 py-3.5 rounded-full glass-card text-pastel-dark font-semibold hover:bg-white/90 transition-all flex items-center gap-2">
          <i data-lucide="key-round" class="w-4 h-4 text-pastel-peach"></i>
          <span>Unlock 30+ Video Vault</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION B: OUR JOURNEY & MEMORY LANE (1-YEAR TIMELINE)
  =========================================== -->
  <section id="timeline" class="py-24 px-4 relative z-10">
    <div class="max-w-5xl mx-auto">
      
      <!-- Section Header -->
      <div class="text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-pink-500 bg-pastel-pink/30 px-4 py-1.5 rounded-full">
          Chapter One: 365 Days of Magic
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl font-bold text-pastel-dark mt-4 mb-4">
          Our Journey & Memory Lane
        </h2>
        <p class="max-w-xl mx-auto text-pastel-muted text-sm sm:text-base">
          Every date, every nervous laugh, and every quiet moment from our first year together is etched into my heart. Here are the milestones that built us.
        </p>
      </div>

      <!-- Vertical Timeline Container -->
      <div class="relative">
        <!-- Center Glowing Line -->
        <div class="hidden md:block absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-gradient-to-b from-pastel-peach via-pastel-lavender to-pastel-periwinkle rounded-full"></div>

        <!-- Timeline Items Injected via JS for Clean Editing -->
        <div id="timeline-container" class="space-y-12 md:space-y-16"></div>
      </div>

    </div>
  </section>

  <!-- ==========================================
       SECTION C: THE SECRET CODE-LOCKED VIDEO VAULT (30+ VIDEOS)
  =========================================== -->
  <section id="vault" class="py-24 px-4 relative z-10">
    <div class="max-w-6xl mx-auto">
      
      <!-- Section Header -->
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-purple-600 bg-pastel-lavender/40 px-4 py-1.5 rounded-full">
          For Cupcakes' Eyes Only
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl font-bold text-pastel-dark mt-4 mb-4">
          The Secret Video Vault
        </h2>
        <p class="max-w-xl mx-auto text-pastel-muted text-sm sm:text-base">
          I recorded and collected 32 videos for you—vlogs, late-night talks, goofy dates, and messages for the next 4 years. Enter our secret passcode to open the vault.
        </p>
      </div>

      <!-- LOCKED STATE VIEW -->
      <div id="vault-locked" class="max-w-lg mx-auto glass-card rounded-3xl p-8 sm:p-10 text-center relative overflow-hidden">
        <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-pastel-peach to-pastel-lavender mx-auto flex items-center justify-center text-white shadow-lg mb-6">
          <i data-lucide="lock-keyhole" class="w-9 h-9"></i>
        </div>

        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-pastel-dark mb-2">
          32 Memories Locked Inside
        </h3>
        <p class="text-xs sm:text-sm text-pastel-muted mb-6">
          Hint: <span class="italic font-medium text-pastel-dark">"Your sweet nickname (singular) + the number of years I'll be studying"</span> (e.g., <code class="bg-white/80 px-2 py-0.5 rounded text-pink-500">CUPCAKE4</code>)
        </p>

        <form onsubmit="unlockVault(event)" class="space-y-4">
          <div id="passcode-box" class="relative">
            <input 
              type="text" 
              id="vault-input" 
              placeholder="Enter Secret Passcode..." 
              class="w-full px-5 py-3.5 rounded-2xl bg-white/90 border-2 border-pastel-pink focus:border-pastel-lavender focus:outline-none text-center font-bold tracking-widest text-pastel-dark uppercase placeholder:normal-case placeholder:tracking-normal placeholder:font-normal"
              autocomplete="off"
            />
          </div>
          <p id="vault-error" class="text-xs text-rose-500 font-medium hidden">
            Hmm, that's not quite right, Cupcakes! Try typing: CUPCAKE4
          </p>
          <button 
            type="submit" 
            class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-pastel-peach via-pastel-pink to-pastel-lavender text-pastel-dark font-bold shadow-md hover:shadow-lg hover:scale-[1.01] transition-all flex items-center justify-center gap-2"
          >
            <i data-lucide="sparkles" class="w-4 h-4"></i>
            <span>Unlock Our 32 Videos</span>
          </button>
        </form>
      </div>

      <!-- UNLOCKED STATE VIEW (Hidden Until Unlocked) -->
      <div id="vault-unlocked" class="hidden space-y-10 transition-all duration-700">
        
        <!-- Unlocked Banner & Filter Controls -->
        <div class="glass-card rounded-2xl p-4 sm:p-6 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center">
              <i data-lucide="unlock" class="w-5 h-5"></i>
            </div>
            <div>
              <h4 class="font-bold text-pastel-dark text-sm sm:text-base">Vault Unlocked, Welcome Cupcakes!</h4>
              <p class="text-xs text-pastel-muted">Showing all 32 personal video memories & messages</p>
            </div>
          </div>

          <!-- View Switcher / Filter Pills -->
          <div class="flex flex-wrap items-center gap-2">
            <button onclick="filterVideos('all')" class="vault-filter-btn active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-pastel-dark text-white transition">
              All 32 Videos
            </button>
            <button onclick="filterVideos('Favorites')" class="vault-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/80 text-pastel-dark hover:bg-white transition">
              Our Favorites
            </button>
            <button onclick="filterVideos('Dates & Trips')" class="vault-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/80 text-pastel-dark hover:bg-white transition">
              Dates & Trips
            </button>
            <button onclick="filterVideos('Future Letters')" class="vault-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/80 text-pastel-dark hover:bg-white transition">
              4-Year Messages
            </button>
          </div>
        </div>

        <!-- Netflix-Style Featured Horizontal Carousel -->
        <div>
          <div class="flex items-center justify-between mb-3 px-1">
            <h3 class="font-serif text-2xl font-bold text-pastel-dark flex items-center gap-2">
              <i data-lucide="flame" class="w-5 h-5 text-pastel-peach"></i>
              Featured Highlights Reel (Swipe / Scroll)
            </h3>
            <div class="flex gap-2">
              <button onclick="scrollCarousel(-1)" class="p-2 rounded-full glass-card hover:bg-white transition">
                <i data-lucide="chevron-left" class="w-4 h-4"></i>
              </button>
              <button onclick="scrollCarousel(1)" class="p-2 rounded-full glass-card hover:bg-white transition">
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
          <div id="video-carousel" class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth">
            <!-- Featured Row Injected via JS -->
          </div>
        </div>

        <!-- Complete 32-Video Clickable Grid Gallery -->
        <div>
          <h3 class="font-serif text-2xl font-bold text-pastel-dark mb-4 px-1 flex items-center gap-2">
            <i data-lucide="film" class="w-5 h-5 text-pastel-lavender"></i>
            Complete Video Archive (<span id="video-count-label">32</span>)
          </h3>
          <div id="video-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
            <!-- 32 Video Cards Injected via JS -->
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ==========================================
       SECTION D: "OPEN WHEN" DIGITAL ENVELOPES
  =========================================== -->
  <section id="open-when" class="py-24 px-4 relative z-10">
    <div class="max-w-6xl mx-auto">
      
      <!-- Section Header -->
      <div class="text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-pink-500 bg-pastel-pink/30 px-4 py-1.5 rounded-full">
          Letters Across Time & Distance
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl font-bold text-pastel-dark mt-4 mb-4">
